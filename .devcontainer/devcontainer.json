{
  "name": "Bootcamp",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "forwardPorts": [
    3000,
    5173
  ],
  "postCreateCommand": "npm install -g vercel @anthropic-ai/claude-code && ([ -f package.json ] && npm install || true)",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-vsliveshare.vsliveshare"
      ]
    }
  },
  "containerEnv": {
    "ANTHROPIC_MODEL": "claude-haiku-5-5"
  }
}
